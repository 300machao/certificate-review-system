# Production and private business data. Never version these paths.
/data/
/validation/
acceptance-result.*
review-*.json
review-*.csv
work-acceptance*.json
work-acceptance*.csv
*.expectations.local.json

# Runtime databases and sidecars, even if copied outside data/.
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.wal
*.shm
*-wal
*-shm
*-journal

# Runtime state and logs.
*.log
*.pid
/logs/

# Credentials, encrypted credential stores, and local environment files.
.env
.env.*
!.env.example
*.key
*.secret
*.pem
*.p12
*.pfx
*.cer
*.crt
*.token
*.credentials
*[dD][pP][aA][pP][iI]*
*[aA][pP][iI]-[kK][eE][yY]*
*[aA][pP][iI]_[kK][eE][yY]*
*[aA][pP][iI][kK][eE][yY]*
credentials.json
credentials.*.json
secrets.json
secrets.*.json

# Python, test, editor, and package caches.
.venv/
venv/
env/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
coverage.xml
htmlcov/
*.py[cod]
*.egg-info/
node_modules/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Generated builds and temporary files.
/build/
/dist/
*.exe
*.dll
*.tmp
*.temp
~$*

